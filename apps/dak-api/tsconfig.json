// Workers runtime: types come from `wrangler types` (worker-configuration.d.ts), not DOM or Node.
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "worker-configuration.d.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "drizzle.*.config.ts",
    "scripts/**/*.ts"
  ],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2024"],
    "types": ["@cloudflare/vitest-plugin/types"],
    "noUncheckedIndexedAccess": true,
    "noEmit": true
  }
}
