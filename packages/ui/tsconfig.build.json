{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  /* Stories live beside their components so a change and its documentation
   * land in one diff, but they are development artefacts: they must not
   * appear in the published types, and they pull in Storybook packages that
   * consumers do not have. */
  "exclude": ["src/**/*.stories.tsx", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
