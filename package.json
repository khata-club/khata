{
  "name": "khata",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "biome format --write .",
    "check-contrast": "pnpm --filter @khata-club/design-tokens check-contrast",
    "storybook": "pnpm --filter @khata-club/storybook dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "turbo": "^2.1.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.26.0"
}
